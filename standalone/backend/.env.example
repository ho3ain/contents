# ---------------------------------------------------------------------------
# Extracted MESH content feature — backend environment
# ---------------------------------------------------------------------------
# Copy to `.env` inside workdir/ and fill in real values.
#
# NOTE: this file lists only what the extracted content code needs. MESH's own
# `src/config/env.validation.ts` (copied to the mirror as reference) validates a
# much larger schema for the full platform. The standalone ContentAppModule uses
# plain ConfigModule without that validator, so nothing here is enforced at boot
# — a wrong value fails later, at first use.

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenthub
DB_USERNAME=agenthub
DB_PASSWORD=change-me

# --- HTTP -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Public site URL --------------------------------------------------------
# Used to build canonical URLs, sitemap entries and JSON-LD in the SEO module.
# Must be the externally visible origin, with no trailing slash.
SITE_URL=http://localhost:5173

# --- Media storage ----------------------------------------------------------
# The storage module writes editorial uploads (cover images, in-article media)
# under this directory. Must be writable by the API process.
UPLOAD_DIR=./uploads
